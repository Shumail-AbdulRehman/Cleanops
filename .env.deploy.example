POSTGRES_DB=cleanops
POSTGRES_USER=cleanops
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://cleanops:change_me@postgres:5432/cleanops?schema=public

BACKEND_IMAGE=ghcr.io/OWNER/cleanops-backend:latest
FRONTEND_IMAGE=ghcr.io/OWNER/cleanops-frontend:latest
MOBILE_WEB_IMAGE=ghcr.io/OWNER/cleanops-mobile-web:latest

FRONTEND_URL=https://app.example.com
BACKEND_PORT=8080
FRONTEND_PORT=80
MOBILE_WEB_PORT=8081

ACCESS_TOKEN_SECRET=replace_me
REFRESH_TOKEN_SECRET=replace_me
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
STAFF_REFRESH_TOKEN_EXPIRY=30d
# Turn on only after configuring Expo FCM/APNs credentials and rebuilding the app.
STAFF_PUSH_ENABLED=false
STAFF_EXPO_PROJECT_ID=68ea9f06-53f5-444f-8760-329fd733ae8e
EXPO_PUSH_ACCESS_TOKEN=
STAFF_CHECKIN_GRACE_MINUTES=10
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
MAX_TASK_REASSIGNMENTS=3

# Inventory verification: independent random server signing keys (at least 32 characters)
VERIFICATION_QR_SECRET=
VERIFICATION_SLOT_SECRET=
VERIFICATION_QR_KEY_ID=v1

# Native inventory workflow. Legacy active tasks retain their frozen v1 contract.
VERIFICATION_MIN_NATIVE_VERSION=2.0.0
# Evaluated provider configuration for direct backend photo requests.

# Clef handles privacy, required-view/identity checks and cleanliness. No automatic-pass switch.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLEF_MODEL=clef
CLEF_TIMEOUT_MS=30000
# Provisional privacy/view screening cutoff; never enables automatic cleanliness passing.
CLEF_SCREENING_CONFIDENCE_THRESHOLD=0.9
# No default threshold. Candidate for evaluation only, NOT validated.
CLEF_CONFIDENCE_THRESHOLD=
CLEF_THRESHOLD_VERSION=unvalidated-no-threshold
# Private reviewed release. Compose path must point inside the read-only mount.
CLEF_RELEASE_RECORD_PATH=
CLEF_RELEASE_RECORD_SHA256=
VERIFICATION_RELEASES_DIRECTORY=./backend/verification-releases
